rvwittcover Small[[0]] {rvmon[[0]]{1}, zero[RVPoly([0],0)]};
rvWittBreaks[Small];
rvWittGenus[Small];
rvWittLPolynomial[Small];
rvWittCharacterL[Small];
rvWittNewton[Small];
// In the Witt ring, (1,0)+(1,0)=(0,1). Thus the parameter x=1
// does not contribute over F4 even though both ordinary traces vanish.
rvWittPoints[Small,2];
rvWittPoints[Small,4];

rvwittcover CubicSecond[[0]] {rvmon[[0]]{1}, rvmon[[0]]{3}};
rvWittBreaks[CubicSecond];
rvWittGenus[CubicSecond];
rvWittLPolynomial[CubicSecond];
rvWittCharacterL[CubicSecond];
rvWittNewton[CubicSecond];
rvWittPoints[CubicSecond,6];

rvwittcover CubicFirst[[0]] {rvmon[[0]]{3}, zero[RVPoly([0],0)]};
rvWittBreaks[CubicFirst];
rvWittGenus[CubicFirst];
rvWittLPolynomial[CubicFirst];
rvWittCharacterL[CubicFirst];
rvWittNewton[CubicFirst];
rvWittPoints[CubicFirst,8];
