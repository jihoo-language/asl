rvunram F[3,1]{0,1};
let zeroF = rvUnramElem[F]{0};
let oneF = rvUnramElem[F]{1};
let twoF = rvUnramElem[F]{2};
rvhyperelliptic C[F]{zeroF,oneF,oneF,oneF,twoF,oneF};
rvHWWWeil[C];
rvJacCount[C];
rvJacEnumerate[C];
let ramified = rvJacPoint[C](zeroF,zeroF);
assert ramified == rvjac[C]{[],[1]}{};
assert rvJacU[1](ramified) == oneF;
assert add(ramified,ramified) == zero[RVJac(C)];
assert rvjac[C]{[],[1],[1],[1],[2],[1]}{} == zero[RVJac(C)];
rvJacOrder(ramified);

rvunram W[3,1]{1,2,0,1};
rvjacbase L[C,W];
let z = rvUnramElem[W]{0,1};
let y = rvUnramElem[W]{0,1,1};
let d = rvJacPoint[L](z,y);
let f = rvJacFrob[C,1](d);
assert rvJacU[0](f) == rvUnramElem[W]{1,2};
assert rvJacFrob[C,3](d) == d;
let double = rvjac[L]{[0,0,1],[0,1],[1]}{[0,2,2],[2,2]};
assert add(d,d) == double;
assert add(d,neg(d)) == zero[RVJac(L)];
assert rvJacFrob[C,1](double) == add(f,f);
let r = rvJacExtend[L](ramified);
assert rvJacDescend[C](r) == ramified;
assert rvJacFrob[C,1](r) == r;
assert rvJacScale[194](d) == zero[RVJac(L)];
assert rvJacScale[97](d) == rvjac[L]{[],[1],[1]}{};
assert rvJacU[2](double) == rvUnramElem[W]{1};
rvJacCount[L];
rvJacOrder(d);
let relation = add(add(rvJacFrob[C,4](d),rvJacScale[-2](rvJacFrob[C,2](d))),rvJacScale[9](d));
assert relation == rvJacWeilApply[C](d);
assert relation == zero[RVJac(L)];
show relation;
