// Distinct curves in the ordinary F41 isogeny class of discriminant -20.
rvunram K[41,1]{0,1};
rvunram L[41,1]{38,0,1};
rvhyperelliptic E[K]{rvUnramElem[K]{17},rvUnramElem[K]{1},rvUnramElem[K]{0},rvUnramElem[K]{1}};
rvhyperelliptic F[K]{rvUnramElem[K]{3},rvUnramElem[K]{30},rvUnramElem[K]{0},rvUnramElem[K]{1}};
rvellglue C[E,F](rvUnramElem[K]{28},rvUnramElem[K]{2},rvUnramElem[K]{1},rvUnramElem[K]{40});
rvjacbase EL[E,L];
rvjacbase FL[F,L];
rvellglue CL[EL,FL](rvUnramElem[L]{28},rvUnramElem[L]{2},rvUnramElem[L]{1},rvUnramElem[L]{40});
rvjacchart SL[CL](rvUnramElem[L]{0,4});
let P=rvJacPoint[EL](rvUnramElem[L]{34},rvUnramElem[L]{6});
let Q=rvJacPoint[EL](rvUnramElem[L]{23},rvUnramElem[L]{0,16});
let R=rvJacPoint[FL](rvUnramElem[L]{7},rvUnramElem[L]{8});
let T=rvJacPoint[FL](rvUnramElem[L]{31},rvUnramElem[L]{0,13});
let e1=rvEllGlueMap[SL](P,zero[RVJac(FL)]);
let e2=rvEllGlueMap[SL](zero[RVJac(EL)],R);
let f1=rvEllGlueMap[SL](Q,zero[RVJac(FL)]);
let f2=rvEllGlueMap[SL](zero[RVJac(EL)],T);
rvjactorsionbasis B[SL,3](rvUnramElem[L]{20,25}){e1,e2,f1,neg(f2)};

rvec E[K](rvUnramElem[K]{1},rvUnramElem[K]{17});
rvecisogeny I2[E,F](rveckernel[E,2]{[6],[1]});
rvecisogeny I3[E,F3](rveckernel[E,3]{[7],[1]});
let phi=rvECMap(rvECIso[I2]);
let rawpsi=rvECMap(rvECIso[I3]);
let psi=rvECMapCompose(rvECChart[F3,F](rvUnramElem[K]{12}),rawpsi);
rvcmhom H(phi,psi);
rvCMHomData[H];
rvCMHomNorm[H,1,1];
rvCMHomNorm[H,1,-1];
rvECMapDegree(rvCMHomMap[H,1,1]);
rvECMapDegree(rvCMHomMap[H,1,-1]);
assert rvCMHomMap[H,1,-1]==rvECSum(phi,rvECNegate(psi));
rvcmorder O[-20];
assert rvCMHomClass[O,H]==rvCMClass[O,2,2,3];

rvjactorsionbasis BE[EL,3](rvJacWeil[3](P,Q)){P,Q};
rvjactorsionbasis BF[FL,3](rvJacWeil[3](R,neg(T))){R,neg(T)};
rvcmhommark M[H,C,B,BE,BF];
rvCMHomMarkData[M];
let axis=rvCMHomCycle[H]{1,0,0,0};
let graph2=rvCMHomCycle[H]{0,0,1,0};
let graph3=rvCMHomCycle[H]{0,0,0,1};
let g2=rvCMHomLift[M](graph2);
let g3=rvCMHomLift[M](graph3);
rvCMHomCyclePair(axis,graph2);
rvCMHomCyclePair(graph2,graph3);
rvCMHomWedgePair(rvCMHomLift[M](axis),g2);
assert rvCMHomFrob[1](g2)==g2;
assert rvCMHomFrob[1](g3)==g3;
let trans=rvCMHomWedge[M]{1,0,0,0,0,0};
assert rvCMHomAlgebraic(trans)==zero[RVCMHomWedge(M)];
assert rvCMHomTranscendental(trans)==trans;
assert rvCMHomAlgebraic(g3)==g3;
assert rvCMHomFrob[1](trans)==neg(trans);
assert rvCMHomFrob[2](trans)==trans;
