// The ordered supersingular nodes are the edges of the two-component graph.
rvmanin M7[7];
rvunram F7[7,1]{-3,0,1};
rvfrickess B7[F7];
rvfrickebad S7[M7,B7];
rvFrickeBadData[S7];
rvFrickeBadWD[S7];
rvFrickeBadHeckeData[S7,3];
rvFrickeBadHeckeData[S7,5];
rvFrickeOrderedHeckeCoeff[3,1,1];
rvFrickeOrderedHeckeCoeff[5,4,4];

assert rvFrickeBadNode[S7,0]==rvUnramElem[F7]{1};
assert rvFrickeBadNode[S7,1]==rvUnramElem[F7]{6};
let x7=rvFrickeCycle[S7]{1};
let g7=rvFrickeMonodromy(x7);
assert g7==rvFrickeDual[S7]{3};
assert rvFrickeComponentClass(g7)==zero[RVFrickeComponent(S7)];
let c7=rvFrickeComponent[S7,1];
assert rvFrickeComponentClass(rvFrickeComponentLift(c7))==c7;
assert add(c7,rvFrickeComponent[S7,2])==zero[RVFrickeComponent(S7)];
assert rvFrickeBadHecke[3](x7)==rvFrickeCycle[S7]{-2};
assert rvFrickeBadHecke[3](c7)==c7;
assert rvFrickeBadHecke[5](c7)==zero[RVFrickeComponent(S7)];
rvFrickeLink(c7,c7);

rvmanin M23[23];
rvunram F23[23,1]{-5,0,1};
rvfrickess B23[F23];
rvfrickebad S23[M23,B23];
rvFrickeBadData[S23];
rvFrickeBadWD[S23];
rvFrickeBadHeckeData[S23,3];
rvFrickeBadHeckeData[S23,5];
let x23=rvFrickeCycle[S23]{1,0,-1,0,2};
let c23=rvFrickeComponent[S23,1];
assert rvFrickeBadFrob(x23)==x23;
assert rvFrickeBadAtkin[23](x23)==neg(x23);
assert rvFrickeBadHecke[3](c23)==rvFrickeComponent[S23,4];
assert rvFrickeBadHecke[5](c23)==rvFrickeComponent[S23,6];
assert rvFrickeMonodromy(rvFrickeBadHecke[3](x23))==rvFrickeBadHecke[3](rvFrickeMonodromy(x23));
rvFrickeLink(c23,c23);
let edge23=rvFrickeComponentClass(rvFrickeDual[S23]{1,0,0,0,0});
rvFrickeLink(edge23,edge23);

rvmanin M41[41];
rvunram F41[41,1]{-3,0,1};
rvfrickess B41[F41];
rvfrickebad S41[M41,B41];
rvFrickeBadData[S41];
rvFrickeBadWD[S41];
rvFrickeBadHeckeData[S41,3];
rvFrickeBadHeckeData[S41,5];
let x41=rvFrickeCycle[S41]{0,1,0,0,0,0,0,0,0};
assert rvFrickeBadFrob(x41)==rvFrickeCycle[S41]{0,0,1,0,0,0,0,0,0};
assert rvFrickeBadFrob(rvFrickeBadFrob(x41))==x41;
assert rvFrickeBadAtkin[41](x41)==neg(rvFrickeBadFrob(x41));
assert rvFrickeBadHecke[3](rvFrickeBadAtkin[2](x41))==rvFrickeBadAtkin[2](rvFrickeBadHecke[3](x41));
let c41=rvFrickeComponentClass(rvFrickeDual[S41]{1,0,0,0,0,0,0,0,0});
assert rvFrickeBadFrob(c41)==c41;
assert rvFrickeBadAtkin[41](c41)==neg(c41);
rvFrickeLink(c41,c41);

rvmanin M5[5];
rvunram F5[5,1]{-2,0,1};
rvfrickess B5[F5];
rvfrickebad S5[M5,B5];
rvFrickeBadData[S5];
rvFrickeBadWD[S5];
rvFrickeBadHeckeData[S5,3];
assert rvFrickeMonodromy(rvFrickeCycle[S5]{})==zero[RVFrickeDual(S5)];
