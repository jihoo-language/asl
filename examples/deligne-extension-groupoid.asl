let S = rvPartitionHallModule[1,0,2]{(0,1,2)};
rvpartitionextensions E(S,S);
rvPartitionExtensionGroupoid[E];
rvPartitionExtensionDistribution[E];
let a = rvPartitionExtension[E]{1,0,0,0};
let b = rvPartitionExtension[E]{0,0,0,1};
let rankOne = rvPartitionHallModule[1,0,2]{(0,1,2),(0,2,1)};
let rankTwo = rvPartitionHallModule[1,0,2]{(0,2,2)};
assert rvPartitionExtensionMiddle(a) == rankOne;
assert rvPartitionExtensionMiddle(b) == rankOne;
assert rvPartitionExtensionMiddle(add(a,b)) == rankTwo;
rvPartitionExtensionLift(add(a,b));
let J = rvPartitionHallModule[1,0,2]{(0,2,1)};
let T = rvPartitionHallModule[1,0,2]{(0,1,1)};
rvpartitionextensions G(J,T);
rvPartitionExtensionCoboundary[G]{0,1};
assert rvPartitionExtensionCocycle[G]{1,0} == zero[RVPartitionExtension(G)];
rvPartitionHallHom(J,S);
rvPartitionHallAut(J);
