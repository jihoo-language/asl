// y^(-1) in the q coefficient of the primitive K3 elliptic genus.
rvK3EllipticGenus[1,1,-1];

// Constant Laurent coefficients for the length-two and length-three Hilbert schemes.
rvK3EllipticGenus[2,0,0];
rvK3EllipticGenus[3,0,0];

// The Weyl prefactor and two higher Fourier coefficients of Phi_10.
rvIgusaPhi10[1,1,0];
rvIgusaPhi10[1,2,-1];
rvIgusaPhi10[2,2,0];
