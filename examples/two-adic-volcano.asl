rvunram F[13,1]{0,1};
rvec G[F](rvUnramElem[F]{4},rvUnramElem[F]{0});
rvec V[F](rvUnramElem[F]{2},rvUnramElem[F]{1});
rvECIsogenies[G,2];
rvEllLocalOrder[G,2];
rvEllLocalOrder[V,2];
assert rvEllFrobCoordinates[G,2,1]==(S.hi,S.hi);
assert rvEllFrobCoordinates[V,2,1]==(S.lo,S.hi);
rvecisogeny Flat[G,H](rveckernel[G,2]{[0],[1]});
rvecisogeny DownA[G,L](rveckernel[G,2]{[10],[1]});
rvecisogeny DownB[G,R](rveckernel[G,2]{[3],[1]});
rvecisogeny Up[V,U](rveckernel[V,2]{[11],[1]});
rvEllEdge[Flat];
rvEllEdge[DownA];
rvEllEdge[DownB];
rvEllEdge[Up];
let f=rvECMap(rvECIso[DownA]);
let d=rvECDual(f);
assert rvECMapKCoeff[0](d)==rvUnramElem[F]{6};
assert rvECMapCompose(d,f)==rvECMultMap[G,2];
assert rvECMapCompose(f,d)==rvECMultMap[L,2];
assert rvECDual(d)==f;
rvECMapDegree(d);
rvEllNeighborhood[G,2];
rvEllNeighborhood[V,2];

rvunram W[17,1]{0,1};
rvec S4[W](rvUnramElem[W]{1},rvUnramElem[W]{0});
rvec N4[W](rvUnramElem[W]{6},rvUnramElem[W]{3});
assert rvEllFrobCoordinates[S4,2,2]==(S.hi,S.hi);
assert rvEllFrobCoordinates[S4,2,2,-1]==(S.hi,S.lo);
assert rvEllFrobCoordinates[N4,2,1]==(S.hi,S.hi);
assert rvEllFrobCoordinates[N4,2,2,1]==(S.lo,S.lo);
rvEllLocalOrder[S4,2];
rvellipticcm K[S4];
let w=rvEllLocalGen[K,S4,2];
assert add(rvQpQuad[K,1,0,1],rvQpQuadMul(rvQpQuad[K,4,0,1],w))==rvCMPi[K];
assert rvQpQuadMul(w,w)==rvQpQuad[K,-1,0,1];
rvEllLocalOrder[N4,2];
