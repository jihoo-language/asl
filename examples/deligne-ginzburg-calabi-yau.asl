rvpartitionginzburg D[1,0,5];
let x = rvPartitionDGArrow[D,0];
let y = rvPartitionDGStar[D,0];
let t = rvPartitionDGLoop[D,0];
let relation = rvPartitionDGDerivative[D,0];
assert relation == rvPartitionDGProduct(x,x);
assert relation == rvPartitionDGDifferential(y);
let commutator = rvPartitionDGDifferential(t);
assert commutator == add(rvPartitionDGPath[D,0]{0,1},neg(rvPartitionDGPath[D,0]{1,0}));
assert rvPartitionDGDifferential(commutator) == zero[RVPartitionDG(D,0)];
rvPartitionDGTrace(commutator);
rvPartitionDGTrace(rvPartitionDGPotential[D]);
let S2 = rvPartitionHallModule[1,0,5]{(0,1,2)};
let J2 = rvPartitionHallModule[1,0,5]{(0,2,1)};
rvPartitionDGTangent[D](S2);
rvPartitionDGTangent[D](J2);
rvPartitionDGCohomology[D,0](J2);
rvunram F[3,1]{1,0,1};
rvpartitionginzburg C[2,0,F];
let M = rvPartitionHallModule[2,0,F]{(0,2,1)};
rvPartitionDGInfo[C];
rvPartitionDGPotentialTrace[C](M);
rvPartitionDGComplex[C](M);
rvPartitionDGTangent[C](M);
rvpartitionginzburggradient G[1,0,3];
rvPartitionDGInfo[G];
assert rvPartitionDGDifferential(rvPartitionDGStar[G,0]) == rvPartitionDGPath[G,0]{0,0};
