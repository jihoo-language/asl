rvasodd Pure[5] {(6,1)};
rvasodd Cubic[5] {(6,1),(3,1)};
rvasodd Quartic[5] {(6,1),(4,1)};
rvasodd Twist[5] {(6,1),(3,1),(0,-1)};
rvasodd Rewrite[5] {(150,1),(15,-2),(3,3),(25,1),(1,-1),(0,-5)};
rvasodd Septic[7] {(3,1)};
rvASOddReduced[Rewrite];
rvASOddGenus[Cubic];
rvASOddPrank[Cubic];
rvASOddCharacterNewton[Pure,1];
rvASOddCharacterNewton[Cubic,1];
rvASOddCharacterNewton[Quartic,1];
rvASOddNewton[Cubic];
rvASOddCharacterNewton[Septic,1];
rvASOddNewton[Septic];
rvASOddPoints[Cubic,1];
rvASOddPoints[Twist,1];
rvASOddPoints[Pure,6];
rvASOddPoints[Cubic,6];
rvASOddPoints[Quartic,6];
rvASOddPoints[Cubic,14];
rvASOddPoints[Twist,14];
let entry = rvASOddCoeff[Cubic,1,3];
assert rvASOddCoeff[Rewrite,1,3] == entry;
assert rvASOddCoeff[Cubic,4,3] == rvCycloConj(entry);
assert rvASOddCoeff[Twist,1,3] == rvCycloMul(rvCyclo[5,-3],entry);
assert rvASOddCoeff[Twist,4,2] == rvCycloMul(rvCyclo[5,-8],rvASOddCoeff[Cubic,4,2]);
