let one=rvCyclo[3,0];
let two_zeta=rvCycloScale[2](rvCyclo[3,1]);
assert z==rvCycloRat[3](add(one,two_zeta));
assert rvDWValue[Reverse]==rvCycloQGalois[-1](z);
assert rvDWValue[Untwisted]==rvCycloRat[1](one);
assert rvDWValue[Shifted]==z;
show z;show rvDWValue[Reverse];show rvDWValue[Untwisted];
