let r3=rvJacPoint[C](nine,z);
rvjactorsionbasis B[C,2](neg(o)){r0,add(add(r0,r1),r2),r1,add(add(r0,r1),r3)};
rvk3pencil P[B,0,14];

let p=rvK3PencilSectionPoint[P]{[0],[18],[2],[5]}{[1]}{[0],[0],[18],[11],[10],[5],[6]}{[1]};
