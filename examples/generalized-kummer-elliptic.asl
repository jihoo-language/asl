// Length one is a point, and length two is a Kummer K3.
rvGenKummerElliptic[1,0,0];
rvGenKummerElliptic[2,2,0];
rvK3EllipticGenus[1,2,0];

// The length-three constant row is 90 + 6(y+y^-1) + 3(y^2+y^-2).
rvGenKummerElliptic[3,0,0];
rvGenKummerElliptic[3,0,1];
rvGenKummerElliptic[3,0,2];
rvGenKummerElliptic[3,1,0];
rvGenKummerElliptic[3,2,4];

// Composite length four includes the proper divisor two in the numerator.
rvGenKummerElliptic[4,0,0];
rvGenKummerElliptic[4,2,5];
