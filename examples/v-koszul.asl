let raw1 = mword[One, 0, 0, RP4, 1, 0](cword{});
let raw3 = mword[One, 0, 0, RP4, 3, 0](cword{});
let raw4 = mword[One, 0, 0, RP4, 4, 0](cword{});
let q1 = qClass(qRes[0, 1](raw1));
let z1 = vLocal(q1);
let z3 = vLocal(qClass(qRes[0, 1](raw3)));
let v0 = vLocal(qClass(qRes[0, 1](cword{[1]})));
let ratio = vShift[-1](v0);
let z1OnlyQ1 = vLocal(qRes[1](q1));

// The differential of the top cell identifies these two classes.
assert qD(vLocal(qRes[0, 1](raw4))) == vLocal(qD(qRes[0, 1](raw4)));
assert z1 == vextgen[One, RP4, [0, 1], 0, 1, 0];
assert z3 == vextgen[One, RP4, [0, 1], 0, 3, 0];
assert ecomp(z3, ratio) == z1;
assert ecomp(z1, ratio) == zero[VExt(One, RP4, [0, 1], 0, -1)];
assert z1OnlyQ1 == zero[VExt(One, RP4, [1], 0, 1)];
assert qClass(qRep(vShift[1](z3))) == vShift[1](z3);
assert vShift[-1](vShift[1](z3)) == z3;

vextdim[One, RP4, [0, 1], 0, 0];
vextdim[One, RP4, [0, 1], 0, 1];
vextdim[One, RP4, [0, 1], 0, 2];
vextdim[One, RP4, [0, 1], 0, 3];
vextdim[One, RP4, [0, 1], 0, 4];
