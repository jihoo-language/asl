mixedcomplex X[3] {x:0} {} {};
mixedcomplex Y[3] {y:2000000000} {} {};
mixhom XY[X,Y];

let x = mixchain[X,0][(x,1)];
let y = mixchain[Y,2000000000][(y,1)];
let f = mixU[1000000000](mixunit[XY,x,y]);
mixcone Cofiber(f);
let sx = mixConeLift[Cofiber](x);
let iy = mixConeI[Cofiber](y);
assert mixConeP[Cofiber](sx) == x;
assert mixDelta[1000000000](sx) == iy;
assert mixD(mixU[0](sx)) == mixU[1000000000](iy);
assert mixD(mixgen[Cofiber,999999999,1,0,0]) == zero[MixedE(Cofiber,999999999,0,999999999)];
let top = mixD(mixgen[Cofiber,1000000000,1,0,0]);
assert top == mixgen[Cofiber,1000000000,0,1000000000,0];
show top;
mixdim[Cofiber,1000000001,1,0];
mixdim[Cofiber,1000000001,0,1000000000];
assert mixBarRep[Cofiber,0] == mixU[0](iy);
assert mixBarNull[Cofiber,0] == mixU[0](sx);
assert mixD(mixBarNull[Cofiber,0]) == mixU[1000000000](mixBarRep[Cofiber,0]);
mixbars[Cofiber];
mixcone Split(zero[MixedU(XY,0)]);
let splitSource = mixgen[Split,1000000000,1,0,0];
let splitTarget = mixgen[Split,1000000000,0,1000000000,0];
assert mixD(splitSource) == zero[MixedE(Split,1000000000,0,1000000000)];
assert mixNext(splitSource) == mixgen[Split,1000000001,1,0,0];
assert mixNext(splitTarget) == mixgen[Split,1000000001,0,1000000000,0];
mixbars[Split];
