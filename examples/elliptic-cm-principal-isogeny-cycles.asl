rvcmclasspoly H3[-3];
rvcmclasspolylift H12[H3,2];
rvcmclasspolylift H108[H12,3];
rvunram F[31,1]{0,1};
rvec E[F](rvUnramElem[F]{3},rvUnramElem[F]{15});
rvecendorder M[E,H108];
rveccmcycle K[M,7,1];
rveccmcycle L[M,7,0];
rvECCMCycleData[K];
rvECCMCycleData[L];
rvECCMCycleStep[K,0];
rvECCMCycleStep[K,1];
rvECCMCycleStep[K,2];
assert rvECCMCycleElement[K]==rvECEndElem[M,10,3];
assert rvECCMCycleElement[L]==rvECEndConj(rvECCMCycleElement[K]);
rvECEndNorm(rvECCMCycleElement[K]);
let p=rvECPoint[E](rvUnramElem[F]{3},rvUnramElem[F]{12});
assert rvECCMCycleApply[K](p)==rvECScale[7](p);
assert rvECCMCycleApply[L](p)==rvECScale[13](p);
assert rvECCMCycleApply[K](rvECCMCycleApply[L](p))==rvECScale[343](p);

rvcmclasspoly H8[-8];
rvunram G[11,1]{0,1};
rvec S[G](rvUnramElem[G]{1},rvUnramElem[G]{8});
rvecendorder N[S,H8];
rveccmcycle J[N,3,1];
rvECCMCycleData[J];
rvECCMCycleVerify[J];
let t=rvECPoint[S](rvUnramElem[G]{9},rvUnramElem[G]{3});
assert rvECCMCycleApply[J](t)==rvECInfinity[S];
