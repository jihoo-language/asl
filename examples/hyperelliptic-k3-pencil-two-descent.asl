rvunram F[13,1]{0,1};
let z=rvUnramElem[F]{};
let o=rvUnramElem[F]{1};
let two=rvUnramElem[F]{2};
let three=rvUnramElem[F]{3};
let nine=rvUnramElem[F]{9};
let eleven=rvUnramElem[F]{11};
rvhyperelliptic C[F]{z,eleven,two,nine,three,o};
let r0=rvJacPoint[C](z,z);
let r1=rvJacPoint[C](o,z);
let r2=rvJacPoint[C](two,z);
let r3=rvJacPoint[C](three,z);
rvjactorsionbasis B[C,2](neg(o)){r0,add(add(r0,r1),r2),r1,add(add(r0,r1),r3)};
rvk3pencil P[B,0,1];

rvK3PencilTorsion2[P];
let t0=rvK3PencilTorsion2At[P,0];
let t1=rvK3PencilTorsion2At[P,1];
let t2=rvK3PencilTorsion2At[P,2];
let origin=zero[RVK3PencilSection(P)];
assert add(t0,t1)==t2;
assert add(t0,t0)==origin;
let g=rvK3PencilSectionPoint[P]{[0],[1],[0],[6]}{[1]}{[0],[0],[7],[6],[3]}{[1]};
let twice=add(g,g);
assert add(g,neg(g))==origin;
assert rvK3PencilDivisible2(twice)==S.hi;
assert rvK3PencilDescent2(add(g,t0))==add(rvK3PencilDescent2(g),rvK3PencilDescent2(t0));
show g;
show twice;
show rvK3PencilDescent2(g);
show rvK3PencilDivisible2(g);
