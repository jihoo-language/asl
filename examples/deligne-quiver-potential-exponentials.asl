rvpartitionginzburg C[1,0,7];
let x = rvPartitionQuiverRep[C,[1]]{[1]};
let y = rvPartitionQuiverRep[C,[1]]{[3]};
let z = rvPartitionQuiverTriangular(x,y){[6]};
show z;
rvPartitionQuiverCritical(x);
rvPartitionQuiverTrace(x);
rvPartitionQuiverTrace(y);
rvPartitionQuiverTrace(z);
assert rvPartitionQuiverCharacter[1](x) == rvCyclo[7,5];
let sum = rvPartitionQuiverFourier[C,structure,1,[1]];
assert sum == add(rvCyclo[7,0],rvCycloScale[3](add(rvCyclo[7,2],rvCyclo[7,5])));
show sum;
rvPartitionQuiverDistribution[C,structure,[1]];
rvPartitionQuiverFourierCheck[C,structure,[1]];
rvpartitionginzburg B[2,0,3];
rvPartitionQuiverDistribution[B,structure,[2,0,2]];
rvPartitionQuiverFourierCheck[B,structure,[2,0,2]];
rvunram F[2,2]{1,1,1};
rvpartitionginzburg E[1,0,F];
assert rvPartitionQuiverFourier[E,structure,2,[1]] == neg(rvCycloScale[2](rvCyclo[2,0]));
rvPartitionQuiverDistribution[E,structure,[1]];
