// Compare middle Hodge pieces of a K3 Hilbert square and a Kummer fourfold.
rvK3HilbHodge[2,2,2];
rvJacHilbHodge[2,1,1];
rvGenKummerHodge[3,2,1];
rvGenKummerHodge[3,2,2];

// On the Kummer K3, an order-two translation has twelve +1 and eight -1
// eigenvalues on H^(1,1).
rvGenKummerTranslateHodge[2,2,1,1];
rvGenKummerHodgeSpectrum[2,2,1,1];

// Both primitive cube roots have multiplicity 27 on H^(2,2).
rvGenKummerTranslateHodge[3,3,2,2];
rvGenKummerHodgeSpectrum[3,3,2,2];
