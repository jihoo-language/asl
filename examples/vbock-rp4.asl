// Antipodal faces of the five-dimensional cross-polytope, ordered by inclusion.
// The order complex is a subdivision of real projective four-space.
space RP4 {
  f2_0 < f3_0, f1_0 < f3_0,
  f2_0 < f3_2, f1_0 < f3_2,
  f4_0 < f5_0, f1_0 < f5_0,
  f4_0 < f5_4, f1_0 < f5_4,
  f8_0 < f9_0, f1_0 < f9_0,
  f8_0 < f9_8, f1_0 < f9_8,
  f16_0 < f17_0, f1_0 < f17_0,
  f16_0 < f17_16, f1_0 < f17_16,
  f4_0 < f6_0, f2_0 < f6_0,
  f4_0 < f6_4, f2_0 < f6_4,
  f8_0 < f10_0, f2_0 < f10_0,
  f8_0 < f10_8, f2_0 < f10_8,
  f16_0 < f18_0, f2_0 < f18_0,
  f16_0 < f18_16, f2_0 < f18_16,
  f8_0 < f12_0, f4_0 < f12_0,
  f8_0 < f12_8, f4_0 < f12_8,
  f16_0 < f20_0, f4_0 < f20_0,
  f16_0 < f20_16, f4_0 < f20_16,
  f16_0 < f24_0, f8_0 < f24_0,
  f16_0 < f24_16, f8_0 < f24_16,
  f6_0 < f7_0, f5_0 < f7_0, f3_0 < f7_0,
  f6_4 < f7_2, f5_0 < f7_2, f3_2 < f7_2,
  f6_4 < f7_4, f5_4 < f7_4, f3_0 < f7_4,
  f6_0 < f7_6, f5_4 < f7_6, f3_2 < f7_6,
  f10_0 < f11_0, f9_0 < f11_0, f3_0 < f11_0,
  f10_8 < f11_2, f9_0 < f11_2, f3_2 < f11_2,
  f10_8 < f11_8, f9_8 < f11_8, f3_0 < f11_8,
  f10_0 < f11_10, f9_8 < f11_10, f3_2 < f11_10,
  f18_0 < f19_0, f17_0 < f19_0, f3_0 < f19_0,
  f18_16 < f19_2, f17_0 < f19_2, f3_2 < f19_2,
  f18_16 < f19_16, f17_16 < f19_16, f3_0 < f19_16,
  f18_0 < f19_18, f17_16 < f19_18, f3_2 < f19_18,
  f12_0 < f13_0, f9_0 < f13_0, f5_0 < f13_0,
  f12_8 < f13_4, f9_0 < f13_4, f5_4 < f13_4,
  f12_8 < f13_8, f9_8 < f13_8, f5_0 < f13_8,
  f12_0 < f13_12, f9_8 < f13_12, f5_4 < f13_12,
  f20_0 < f21_0, f17_0 < f21_0, f5_0 < f21_0,
  f20_16 < f21_4, f17_0 < f21_4, f5_4 < f21_4,
  f20_16 < f21_16, f17_16 < f21_16, f5_0 < f21_16,
  f20_0 < f21_20, f17_16 < f21_20, f5_4 < f21_20,
  f24_0 < f25_0, f17_0 < f25_0, f9_0 < f25_0,
  f24_16 < f25_8, f17_0 < f25_8, f9_8 < f25_8,
  f24_16 < f25_16, f17_16 < f25_16, f9_0 < f25_16,
  f24_0 < f25_24, f17_16 < f25_24, f9_8 < f25_24,
  f12_0 < f14_0, f10_0 < f14_0, f6_0 < f14_0,
  f12_8 < f14_4, f10_0 < f14_4, f6_4 < f14_4,
  f12_8 < f14_8, f10_8 < f14_8, f6_0 < f14_8,
  f12_0 < f14_12, f10_8 < f14_12, f6_4 < f14_12,
  f20_0 < f22_0, f18_0 < f22_0, f6_0 < f22_0,
  f20_16 < f22_4, f18_0 < f22_4, f6_4 < f22_4,
  f20_16 < f22_16, f18_16 < f22_16, f6_0 < f22_16,
  f20_0 < f22_20, f18_16 < f22_20, f6_4 < f22_20,
  f24_0 < f26_0, f18_0 < f26_0, f10_0 < f26_0,
  f24_16 < f26_8, f18_0 < f26_8, f10_8 < f26_8,
  f24_16 < f26_16, f18_16 < f26_16, f10_0 < f26_16,
  f24_0 < f26_24, f18_16 < f26_24, f10_8 < f26_24,
  f24_0 < f28_0, f20_0 < f28_0, f12_0 < f28_0,
  f24_16 < f28_8, f20_0 < f28_8, f12_8 < f28_8,
  f24_16 < f28_16, f20_16 < f28_16, f12_0 < f28_16,
  f24_0 < f28_24, f20_16 < f28_24, f12_8 < f28_24,
  f14_0 < f15_0, f13_0 < f15_0, f11_0 < f15_0, f7_0 < f15_0,
  f14_12 < f15_2, f13_0 < f15_2, f11_2 < f15_2, f7_2 < f15_2,
  f14_4 < f15_4, f13_4 < f15_4, f11_0 < f15_4, f7_4 < f15_4,
  f14_8 < f15_6, f13_4 < f15_6, f11_2 < f15_6, f7_6 < f15_6,
  f14_8 < f15_8, f13_8 < f15_8, f11_8 < f15_8, f7_0 < f15_8,
  f14_4 < f15_10, f13_8 < f15_10, f11_10 < f15_10, f7_2 < f15_10,
  f14_12 < f15_12, f13_12 < f15_12, f11_8 < f15_12, f7_4 < f15_12,
  f14_0 < f15_14, f13_12 < f15_14, f11_10 < f15_14, f7_6 < f15_14,
  f22_0 < f23_0, f21_0 < f23_0, f19_0 < f23_0, f7_0 < f23_0,
  f22_20 < f23_2, f21_0 < f23_2, f19_2 < f23_2, f7_2 < f23_2,
  f22_4 < f23_4, f21_4 < f23_4, f19_0 < f23_4, f7_4 < f23_4,
  f22_16 < f23_6, f21_4 < f23_6, f19_2 < f23_6, f7_6 < f23_6,
  f22_16 < f23_16, f21_16 < f23_16, f19_16 < f23_16, f7_0 < f23_16,
  f22_4 < f23_18, f21_16 < f23_18, f19_18 < f23_18, f7_2 < f23_18,
  f22_20 < f23_20, f21_20 < f23_20, f19_16 < f23_20, f7_4 < f23_20,
  f22_0 < f23_22, f21_20 < f23_22, f19_18 < f23_22, f7_6 < f23_22,
  f26_0 < f27_0, f25_0 < f27_0, f19_0 < f27_0, f11_0 < f27_0,
  f26_24 < f27_2, f25_0 < f27_2, f19_2 < f27_2, f11_2 < f27_2,
  f26_8 < f27_8, f25_8 < f27_8, f19_0 < f27_8, f11_8 < f27_8,
  f26_16 < f27_10, f25_8 < f27_10, f19_2 < f27_10, f11_10 < f27_10,
  f26_16 < f27_16, f25_16 < f27_16, f19_16 < f27_16, f11_0 < f27_16,
  f26_8 < f27_18, f25_16 < f27_18, f19_18 < f27_18, f11_2 < f27_18,
  f26_24 < f27_24, f25_24 < f27_24, f19_16 < f27_24, f11_8 < f27_24,
  f26_0 < f27_26, f25_24 < f27_26, f19_18 < f27_26, f11_10 < f27_26,
  f28_0 < f29_0, f25_0 < f29_0, f21_0 < f29_0, f13_0 < f29_0,
  f28_24 < f29_4, f25_0 < f29_4, f21_4 < f29_4, f13_4 < f29_4,
  f28_8 < f29_8, f25_8 < f29_8, f21_0 < f29_8, f13_8 < f29_8,
  f28_16 < f29_12, f25_8 < f29_12, f21_4 < f29_12, f13_12 < f29_12,
  f28_16 < f29_16, f25_16 < f29_16, f21_16 < f29_16, f13_0 < f29_16,
  f28_8 < f29_20, f25_16 < f29_20, f21_20 < f29_20, f13_4 < f29_20,
  f28_24 < f29_24, f25_24 < f29_24, f21_16 < f29_24, f13_8 < f29_24,
  f28_0 < f29_28, f25_24 < f29_28, f21_20 < f29_28, f13_12 < f29_28,
  f28_0 < f30_0, f26_0 < f30_0, f22_0 < f30_0, f14_0 < f30_0,
  f28_24 < f30_4, f26_0 < f30_4, f22_4 < f30_4, f14_4 < f30_4,
  f28_8 < f30_8, f26_8 < f30_8, f22_0 < f30_8, f14_8 < f30_8,
  f28_16 < f30_12, f26_8 < f30_12, f22_4 < f30_12, f14_12 < f30_12,
  f28_16 < f30_16, f26_16 < f30_16, f22_16 < f30_16, f14_0 < f30_16,
  f28_8 < f30_20, f26_16 < f30_20, f22_20 < f30_20, f14_4 < f30_20,
  f28_24 < f30_24, f26_24 < f30_24, f22_16 < f30_24, f14_8 < f30_24,
  f28_0 < f30_28, f26_24 < f30_28, f22_20 < f30_28, f14_12 < f30_28,
  f30_0 < f31_0, f29_0 < f31_0, f27_0 < f31_0, f23_0 < f31_0, f15_0 < f31_0,
  f30_28 < f31_2, f29_0 < f31_2, f27_2 < f31_2, f23_2 < f31_2, f15_2 < f31_2,
  f30_4 < f31_4, f29_4 < f31_4, f27_0 < f31_4, f23_4 < f31_4, f15_4 < f31_4,
  f30_24 < f31_6, f29_4 < f31_6, f27_2 < f31_6, f23_6 < f31_6, f15_6 < f31_6,
  f30_8 < f31_8, f29_8 < f31_8, f27_8 < f31_8, f23_0 < f31_8, f15_8 < f31_8,
  f30_20 < f31_10, f29_8 < f31_10, f27_10 < f31_10, f23_2 < f31_10, f15_10 < f31_10,
  f30_12 < f31_12, f29_12 < f31_12, f27_8 < f31_12, f23_4 < f31_12, f15_12 < f31_12,
  f30_16 < f31_14, f29_12 < f31_14, f27_10 < f31_14, f23_6 < f31_14, f15_14 < f31_14,
  f30_16 < f31_16, f29_16 < f31_16, f27_16 < f31_16, f23_16 < f31_16, f15_0 < f31_16,
  f30_12 < f31_18, f29_16 < f31_18, f27_18 < f31_18, f23_18 < f31_18, f15_2 < f31_18,
  f30_20 < f31_20, f29_20 < f31_20, f27_16 < f31_20, f23_20 < f31_20, f15_4 < f31_20,
  f30_8 < f31_22, f29_20 < f31_22, f27_18 < f31_22, f23_22 < f31_22, f15_6 < f31_22,
  f30_24 < f31_24, f29_24 < f31_24, f27_24 < f31_24, f23_16 < f31_24, f15_8 < f31_24,
  f30_4 < f31_26, f29_24 < f31_26, f27_26 < f31_26, f23_18 < f31_26, f15_10 < f31_26,
  f30_28 < f31_28, f29_28 < f31_28, f27_24 < f31_28, f23_20 < f31_28, f15_12 < f31_28,
  f30_0 < f31_30, f29_28 < f31_30, f27_26 < f31_30, f23_22 < f31_30, f15_14 < f31_30
};

let z0 = vLocal(qRes[0, 1](mword[One, 0, 0, RP4, 0, 0](cword{})));
let z1 = vLocal(qRes[0, 1](mword[One, 0, 0, RP4, 1, 0](cword{})));
let z2 = vLocal(qRes[0, 1](mword[One, 0, 0, RP4, 2, 0](cword{})));
let z3 = vLocal(qRes[0, 1](mword[One, 0, 0, RP4, 3, 0](cword{})));
let z4 = vLocal(qRes[0, 1](mword[One, 0, 0, RP4, 4, 0](cword{})));
let v0 = vLocal(qRes[0, 1](cword{[1]}));
let v1 = vLocal(qRes[0, 1](cword{[0, 1]}));
assert qD(z2) == ecomp(z1, v0);
assert qD(z4) == add(ecomp(z1, v1), ecomp(z3, v0));

// v0 z1 is a d0-boundary, so z2 survives d1.
let e0 = vbClass[0, 0](z2);
let e1 = vbNext(e0);
assert vbD(e1) == zero[VBock(One, RP4, [0, 1], 1, 1, 2, 1)];
let e2 = vbNext(e1);
assert e2 == vbockgen[One, RP4, [0, 1], 2, 0, 2, 0, 0];
let corrected = add(z2, vShift[-1](ecomp(z4, v0)));
let target = vShift[-1](ecomp(z3, ecomp(v0, v0)));
assert qD(corrected) == target;
assert vbRep(e2) == corrected;
let image = vbD(e2);
assert image == vbClass[2, 2](target);
assert image == vbockgen[One, RP4, [0, 1], 2, 1, 2, 2, 0];
assert vbNext(image) == zero[VBock(One, RP4, [0, 1], 3, 1, 2, 2)];
assert vbNext(vbPrev(e2)) == e2;
let v0e2 = vbClass[2, 1](v0);
assert vbD(ecomp(e2, v0e2)) == ecomp(image, v0e2);
show image;

// The same d2 starts in negative cohomological degree after a v1 shift.
let shifted = vShift[-1](e2);
assert vShift[1](shifted) == e2;
assert vbD(shifted) == vShift[-1](image);
assert vbNext(vbD(shifted)) == zero[VBock(One, RP4, [0, 1], 3, 0, -1, 2)];
assert vbNext(vShift[-2](image)) == zero[VBock(One, RP4, [0, 1], 3, -1, -4, 2)];
show vbD(shifted);

vbockdim[One, RP4, [0, 1], 0, 0, 2, 1];
vbockdim[One, RP4, [0, 1], 1, 0, 2, 1];
vbockdim[One, RP4, [0, 1], 2, 0, 2, 0];
vbockdim[One, RP4, [0, 1], 3, 0, 2, 0];
vbockdim[One, RP4, [0, 1], 3, 1, 2, 2];

let stable = vbNext(vbClass[7, 0](z0));
assert qClass(vbRep(stable)) == vextgen[One, RP4, [0, 1], 0, 0, 0];
vextdim[One, RP4, [0, 1], 0, 0];
vextdim[One, RP4, [0, 1], 0, 2];
vextdim[One, RP4, [0, 1], 1, 2];
