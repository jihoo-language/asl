let M = rvPartitionHallModule[1,0,3]{(0,1,2)};
rvpartitionextensions E(M,M);
rvpartitionformal D[E,2,3];
let a = rvPartitionExtension[E]{0,1,0,0};
let b = rvPartitionExtension[E]{0,0,1,0};
let mixed = rvPartitionFormalStart[D](a,b);
rvPartitionFormalObstruction(mixed);
let single = rvPartitionFormalStart[D](a,zero[RVPartitionExtension(E)]);
let exact = rvPartitionFormalLift(rvPartitionFormalLift(single));
assert rvPartitionFormalFirst[0](exact) == a;
let linked = rvPartitionHallModule[2,0,3]{(0,1,1),(2,1,1)};
rvpartitionextensions F(linked,linked);
rvpartitionformal L[F,2,3];
let first = rvPartitionFormalStart[L](rvPartitionExtension[F]{1,0},rvPartitionExtension[F]{0,1});
rvPartitionFormalObstruction(first);
rvPartitionFormalObstruction(rvPartitionFormalLift(first));
let J = rvPartitionHallModule[1,0,3]{(0,2,1)};
rvpartitionextensions G(J,J);
rvpartitionformal C[G,1,3];
let original = rvPartitionFormalTrivial[C];
let conjugate = rvPartitionFormalGauge(original){([1],[0,1,0,0])};
show conjugate;
assert rvPartitionFormalSlice(conjugate) == original;
