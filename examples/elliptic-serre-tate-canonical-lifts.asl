rvcmclasspoly H4[-4];
rvcmclasspolylift H16[H4,2];
rvunram F[13,1]{0,1};
rvunram W[13,3]{0,1};
rvec E[F](rvUnramElem[F]{2},rvUnramElem[F]{1});
rvecendorder M[E,H16];
let j = rvECEndCanonicalJ[M,W];
let alpha = rvECEndUnitRoot[M,W];
let beta = rvECEndNonunitRoot[M,W];
assert j == rvUnramElem[W]{1886};
assert alpha == rvUnramElem[W]{1722};
assert beta == rvUnramElem[W]{481};
assert add(alpha,beta) == rvUnramElem[W]{6};
assert rvUnramMul(alpha,beta) == rvUnramElem[W]{13};
assert rvECEndEmbed[M,W](rvECEndFrobenius[M]) == alpha;
assert rvECEndEmbedConj[M,W](rvECEndFrobenius[M]) == beta;
show j;
show alpha;
show beta;

rvcmclasspoly H3[-3];
rvcmclasspolylift H12[H3,2];
rvcmclasspolylift H48[H12,2];
rvunram L[7,1]{5,5,1};
rvunram U[7,3]{5,5,1};
rvec C[L](rvUnramElem[L]{6,4},rvUnramElem[L]{4,5});
rvecendorder N[C,H48];
let J = rvECEndCanonicalJ[N,U];
let sigmaJ = rvUnramFrob[1](J);
assert J == rvUnramElem[U]{287,71};
assert sigmaJ == rvUnramElem[U]{275,272};
assert add(J,sigmaJ) == rvUnramElem[U]{219};
assert rvUnramMul(J,sigmaJ) == rvUnramElem[U]{201};
assert rvECEndCanonicalPhi[N,U] == zero[RVUnram(U)];
assert rvModularPolyWittEval[7](sigmaJ,J) == zero[RVUnram(U)];
show J;
show sigmaJ;
